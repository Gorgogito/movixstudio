// Recursos de Windows del ejecutable: icono (Explorador, barra de tareas, accesos directos) e
// información de versión. CMake genera movixstudio.rc a partir de esta plantilla.
#pragma code_page(65001)
#include <winver.h>

IDI_ICON1 ICON "@MOVIX_ICON_FILE@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "0C0A04B0"
        BEGIN
            VALUE "CompanyName", "Colaboradores de MovixStudio"
            VALUE "FileDescription", "MovixStudio"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "MovixStudio"
            VALUE "LegalCopyright", "© 2026 Colaboradores de MovixStudio. GPL-3.0-or-later"
            VALUE "OriginalFilename", "MovixStudio.exe"
            VALUE "ProductName", "MovixStudio"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0C0A, 1200
    END
END
